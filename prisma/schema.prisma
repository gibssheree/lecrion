// prisma/schema.prisma
//
// ── Storage strategy ─────────────────────────────────────────────────────────
// Current provider: SQLite (dev / single-node deployments)
// Production target: PostgreSQL — see prisma.config.ts for migration path
//
// ── Timestamp convention ─────────────────────────────────────────────────────
// All timestamp columns use String (ISO 8601) rather than DateTime.
// Reason: SQLite has no native DateTime type; storing as ISO strings avoids
// timezone conversion issues and keeps the schema portable.
// When migrating to PostgreSQL, convert these to @db.Timestamptz(3) columns.
//
// ── Status enum convention ───────────────────────────────────────────────────
// Status values are stored as plain strings. The canonical enum values are
// defined in libs/contracts/src/enums/index.ts — always import from there,
// never hardcode status strings in application code.
//
// ── store_settings key convention ────────────────────────────────────────────
// The store_settings table has no store_id column (single-store schema).
// Application code namespaces keys as "{storeId}:{key}" to support multiple
// stores in the same table. When this table gains a store_id column (future
// schema migration), remove the prefix logic in StoresService.
//
// ── admins table ─────────────────────────────────────────────────────────────
// The admins table is a legacy table from the pre-NestJS era.
// New user accounts use the users table. The admins table is kept for
// backward compatibility with existing data only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Legacy admin accounts (pre-NestJS) ───────────────────────────────────────
model admins {
  id         Int    @id @default(autoincrement())
  email      String @unique(map: "sqlite_autoindex_admins_1")
  password   String
  name       String
  created_at String @default("datetime('now')")
}

// ── Audit log ─────────────────────────────────────────────────────────────────
model audit_logs {
  id             Int     @id @default(autoincrement())
  actor          String
  action         String
  resource       String
  resource_id    String?
  before_value   String?
  after_value    String?
  tenant_id      String  @default("default")
  store_id       String  @default("default-store")
  correlation_id String?
  channel        String  @default("api")
  created_at     String  @default("datetime('now')")

  @@index([created_at(sort: Desc)], map: "idx_audit_created")
  @@index([resource, resource_id], map: "idx_audit_resource")
  @@index([action], map: "idx_audit_action")
  @@index([actor], map: "idx_audit_actor")
}

// ── Cart (per-sender, DB-backed) ──────────────────────────────────────────────
model cart_items {
  id         Int    @id @default(autoincrement())
  sender     String
  product_id Int
  name       String
  price      Float
  qty        Int    @default(1)
  updated_at String @default("datetime('now')")
  menu       menu   @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sender, product_id], map: "sqlite_autoindex_cart_items_1")
  @@index([sender], map: "idx_cart_sender")
}

model carts {
  sender     String @id
  payload    String
  updated_at String
}

// ── Cash register sessions ────────────────────────────────────────────────────
// status values: "open" | "suspended" | "closed"  (RegisterSessionStatus enum)
model cash_register_sessions {
  id            Int     @id @default(autoincrement())
  store_id      String  @default("default-store")
  cashier_id    String
  status        String  @default("open")
  opening_cash  Float   @default(0)
  expected_cash Float   @default(0)
  counted_cash  Float?
  variance      Float?
  notes         String?
  opened_at     String  @default("datetime('now')")
  closed_at     String?

  @@index([store_id, status], map: "idx_register_store")
}

// ── Legacy cashflow table (pre-NestJS ledger) ─────────────────────────────────
// New cashflow entries use cashflow_entries. This table is kept for
// backward compatibility with existing data.
model cashflow {
  id         Int     @id @default(autoincrement())
  type       String
  amount     Float
  category   String
  reference  String?
  note       String?
  actor_id   String?
  created_at String  @default("datetime('now')")
}

// ── Cashflow entries (append-only ledger) ─────────────────────────────────────
// entry_type values: "income" | "expense" | "refund"  (CashflowEntryType enum)
model cashflow_entries {
  id             Int     @id @default(autoincrement())
  session_id     Int
  store_id       String  @default("default-store")
  entry_type     String
  amount         Float
  payment_method String  @default("Cash")
  reference_type String?
  reference_id   String?
  category       String?
  note           String?
  operator_id    String
  created_at     String  @default("datetime('now')")

  @@index([created_at(sort: Desc)], map: "idx_cashflow_created")
  @@index([session_id], map: "idx_cashflow_session")
}

// ── Chat history ──────────────────────────────────────────────────────────────
model chat_history {
  id          Int     @id @default(autoincrement())
  sender      String
  name        String?
  question    String
  reply       String
  type        String  @default("chat")
  cart_items  String?
  total_price Float?
  order_id    Int?
  created_at  String  @default("datetime('now')")

  @@index([created_at(sort: Desc)], map: "idx_chat_created_at")
  @@index([sender], map: "idx_chat_sender")
}

// ── Favorites ─────────────────────────────────────────────────────────────────
model favorites {
  id         Int    @id @default(autoincrement())
  user_id    Int
  menu_id    Int
  created_at String @default("datetime('now')")
  menu       menu   @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, menu_id], map: "sqlite_autoindex_favorites_1")
}

// ── Idempotency keys ──────────────────────────────────────────────────────────
model idempotency_keys {
  key        String @id
  result     String
  created_at String @default("datetime('now')")
  expires_at String

  @@index([expires_at], map: "idx_idempotency_expires")
}

// ── Product categories ────────────────────────────────────────────────────────
// Hierarchical category tree. parent_id = NULL means top-level category.
// slug must be unique per store (e.g. "makanan", "minuman", "bahan-bangunan").
// Phase 6A — 2026-05-15
model product_categories {
  id          Int                  @id @default(autoincrement())
  name        String
  slug        String
  description String?
  parent_id   Int?
  sort_order  Int                  @default(0)
  is_active   Boolean              @default(true)
  store_id    String               @default("default-store")
  created_at  String               @default("datetime('now')")
  updated_at  String               @default("datetime('now')")
  parent      product_categories?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children    product_categories[] @relation("CategoryTree")
  products    menu[]

  @@unique([slug, store_id], map: "uniq_category_slug_store")
  @@index([store_id, is_active], map: "idx_category_store_active")
  @@index([parent_id], map: "idx_category_parent")
}

// ── Product variants ──────────────────────────────────────────────────────────
// Maps a parent product to its variant children.
// variant_type: "size" | "color" | "material" | "grade" | "custom"
// variant_value: the specific value (e.g. "L", "Red", "Grade A")
// Phase 6A — 2026-05-15
model product_variants {
  id                 Int     @id @default(autoincrement())
  parent_product_id  Int
  variant_product_id Int
  variant_type       String  @default("custom")
  variant_value      String
  sort_order         Int     @default(0)
  is_active          Boolean @default(true)
  created_at         String  @default("datetime('now')")
  parent_product     menu    @relation("VariantParent", fields: [parent_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  variant_product    menu    @relation("VariantChild", fields: [variant_product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parent_product_id, variant_product_id], map: "uniq_variant_parent_child")
  @@index([parent_product_id], map: "idx_variant_parent")
  @@index([variant_product_id], map: "idx_variant_child")
}

// ── Product barcodes ──────────────────────────────────────────────────────────
// Additional barcodes per product (a product can have multiple barcodes).
// The primary barcode is still stored in menu.barcode for fast lookup.
// barcode_type: "ean13" | "ean8" | "qr" | "code128" | "internal" | "custom"
// Phase 6A — 2026-05-15
model product_barcodes {
  id           Int     @id @default(autoincrement())
  menu_id      Int
  barcode      String  @unique
  barcode_type String  @default("ean13")
  is_primary   Boolean @default(false)
  created_at   String  @default("datetime('now')")
  menu         menu    @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([menu_id], map: "idx_product_barcodes_menu")
}

// ── Product catalog (menu) ────────────────────────────────────────────────────
// store_id added (SEC-05) — catalog was previously global across all stores;
// every store shared one product table. Existing rows backfill to
// "default-store" via the column default, matching every other store-scoped
// table in this schema (cash_register_sessions, cashflow_entries, etc.).
//
// ── Generalization columns (Phase 4 – 2026-05-15) ────────────────────────────
// All new columns use safe defaults so existing rows need no backfill:
//   product_type     – defaults "simple"; old menu rows are simple products
//   is_stock_tracked – defaults true; existing rows are stock-managed
//   is_active        – defaults true; existing rows are visible/sellable
//   All other new columns are nullable — legacy rows leave them NULL.
//
// product_type values: "simple" | "variant" | "service" | "bundle" | "material"
//   (canonical values in ProductType enum — libs/contracts/src/enums/index.ts)
//
// ── Phase 6A additions (2026-05-15) ──────────────────────────────────────────
//   category_id – FK to product_categories; nullable for legacy rows
model menu {
  id                       Int                        @id @default(autoincrement())
  name                     String
  price                    Float
  cost_price               Float?
  stock                    Int                        @default(0)
  description              String?
  image_url                String?
  store_id                 String                     @default("default-store")
  // ── Generalization fields ─────────────────────────────────────────────────
  sku                      String?
  barcode                  String?
  product_type             String                     @default("simple")
  unit_name                String?
  unit_code                String?
  brand                    String?
  supplier_name            String?
  supplier_id              String?
  attributes               String?
  parent_product_id        Int?
  is_stock_tracked         Boolean                    @default(true)
  is_active                Boolean                    @default(true)
  // ── Phase 6A: category FK ─────────────────────────────────────────────────
  category_id              Int?
  // ─────────────────────────────────────────────────────────────────────────
  cart_items               cart_items[]
  favorites                favorites[]
  order_items              order_items[]
  stock_change_logs        stock_change_logs[]
  inventory_stock_balances inventory_stock_balances[]
  operation_document_lines operation_document_lines[]
  category                 product_categories?        @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  variant_as_parent        product_variants[]         @relation("VariantParent")
  variant_as_child         product_variants[]         @relation("VariantChild")
  product_barcodes         product_barcodes[]
  recipe                   recipes?                   @relation("MenuRecipe")
  recipe_lines             recipe_ingredients[]       @relation("MenuAsIngredient")
  modifier_links           product_modifier_links[]
  stock_opname_lines       stock_opname_lines[]

  @@index([stock], map: "idx_menu_stock")
  @@index([sku], map: "idx_menu_sku")
  @@index([barcode], map: "idx_menu_barcode")
  @@index([product_type], map: "idx_menu_product_type")
  @@index([is_active, is_stock_tracked], map: "idx_menu_active_tracked")
  @@index([category_id], map: "idx_menu_category_id")
  @@index([store_id, is_active], map: "idx_menu_store_active")
}

// ── Notifications ─────────────────────────────────────────────────────────────
model notifications {
  id         Int    @id @default(autoincrement())
  user_id    Int
  order_id   Int?
  title      String
  message    String
  type       String @default("info")
  is_read    Int    @default(0)
  created_at String @default("datetime('now')")
  users      users  @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ── Order items ───────────────────────────────────────────────────────────────
model order_items {
  id       Int    @id @default(autoincrement())
  order_id Int
  menu_id  Int
  name     String
  price    Float
  qty      Int
  menu     menu   @relation(fields: [menu_id], references: [id], onDelete: NoAction)
  orders   orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([menu_id], map: "idx_order_items_menu")
  @@index([order_id], map: "idx_order_items_order")
}

// ── Order ratings ─────────────────────────────────────────────────────────────
model order_ratings {
  id         Int     @id @default(autoincrement())
  order_id   Int     @unique(map: "sqlite_autoindex_order_ratings_1")
  user_id    Int
  rating     Int
  review     String?
  created_at String  @default("datetime('now')")
  users      users   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders     orders  @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ── Orders ────────────────────────────────────────────────────────────────────
// status values: "pending" | "pending_payment" | "paid" | "confirmed" |
//                "completed" | "cancelled" | "refunded"  (OrderStatus enum)
//
// Phase 6D: table_id — FK to dining_tables (nullable, F&B only)
// Phase 7:  customer_id — FK to customers (nullable)
// store_id added (SEC-05) — this table (the chatbot/checkout order flow, as
// opposed to pos_sales) had no store scoping at all; any authenticated user
// could read/cancel/update any order by guessing its id. Existing rows
// backfill to "default-store" via the column default.
model orders {
  id                  Int               @id @default(autoincrement())
  user_id             Int
  type                String
  name                String
  phone               String?           @default("")
  address             String?           @default("")
  delivery_cost       Int?
  payment_method      String?           @default("Transfer")
  status              String            @default("pending")
  created_at          String            @default("datetime('now')")
  estimated_time      Int?              @default(15)
  cancelled_at        String?
  cancellation_reason String?
  store_id            String            @default("default-store")
  // ── Phase 6D: F&B table ───────────────────────────────────────────────────
  table_id            Int?
  // ── Phase 7: customer link ────────────────────────────────────────────────
  customer_id         Int?
  // ── Online Orders & Tablet Stacking ────────────────────────────────────────
  channel             String?           @default("in_store")
  external_order_id   String?
  courier_name        String?
  // ─────────────────────────────────────────────────────────────────────────
  order_items         order_items[]
  order_ratings       order_ratings?
  users               users             @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments            payments[]
  table               dining_tables?    @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer            customers?        @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  kitchen_tickets     kitchen_tickets[]

  @@index([user_id], map: "idx_orders_user")
  @@index([created_at], map: "idx_orders_created_at")
  @@index([status], map: "idx_orders_status")
  @@index([table_id], map: "idx_orders_table")
  @@index([customer_id], map: "idx_orders_customer")
  @@index([store_id, status], map: "idx_orders_store_status")
}

// ── Payments ──────────────────────────────────────────────────────────────────
// status values: "pending" | "paid" | "failed" | "refunded"  (PaymentStatus enum)
model payments {
  id             Int     @id @default(autoincrement())
  order_id       Int
  store_id       String  @default("default-store")
  amount         Float
  paid_amount    Float   @default(0)
  discount       Float   @default(0)
  tax            Float   @default(0)
  payment_method String  @default("Cash")
  status         String  @default("pending")
  completed_at   String?
  created_at     String  @default("datetime('now')")
  orders         orders  @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_payments_status")
  @@index([order_id], map: "idx_payments_order")
}

// ── Read model snapshots (legacy — superseded by report_snapshots) ────────────
// Immutable POS sale / receipt snapshot.
// status values: "paid" | "voided" | "refunded" | "partially_refunded"
// tax_mode values: "exclusive" | "inclusive"
//
// Phase 7 additions (2026-05-15):
//   customer_id   – FK to customers (nullable)
//   promotion_id  – FK to promotions (nullable)
//   voucher_code  – applied voucher code (nullable)
//   loyalty_points_earned   – points earned from this sale
//   loyalty_points_redeemed – points redeemed on this sale
model pos_sales {
  id                      Int               @id @default(autoincrement())
  receipt_number          String            @unique
  client_sale_id          String?
  order_id                Int               @unique
  register_session_id     Int
  cashier_id              String
  store_id                String            @default("default-store")
  customer_name           String?
  customer_phone          String?
  order_type              String
  status                  String            @default("paid")
  subtotal                Float
  discount_amount         Float             @default(0)
  discount_reason         String?
  tax_amount              Float             @default(0)
  tax_mode                String            @default("exclusive")
  service_charge_amount   Float             @default(0)
  total                   Float
  paid_total              Float
  change_amount           Float             @default(0)
  payment_methods         String            @default("[]")
  payment_lines           String            @default("[]")
  // ── Phase 7: customer & promo ─────────────────────────────────────────────
  customer_id             Int?
  promotion_id            Int?
  voucher_code            String?
  loyalty_points_earned   Int               @default(0)
  loyalty_points_redeemed Int               @default(0)
  // ── Online Orders & Tablet Stacking ────────────────────────────────────────
  channel                 String?           @default("in_store")
  external_order_id       String?
  courier_name            String?
  // ─────────────────────────────────────────────────────────────────────────
  created_at              String            @default("datetime('now')")
  pos_sale_items          pos_sale_items[]
  pos_corrections         pos_corrections[]
  customer                customers?        @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  promotion               promotions?       @relation(fields: [promotion_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_pos_sales_created")
  @@index([store_id, created_at], map: "idx_pos_sales_store_created")
  @@index([register_session_id, created_at], map: "idx_pos_sales_session_created")
  @@index([status], map: "idx_pos_sales_status")
  @@index([customer_id], map: "idx_pos_sales_customer")
}

model pos_sale_items {
  id         Int       @id @default(autoincrement())
  sale_id    Int
  product_id Int
  name       String
  qty        Int
  unit_price Float
  line_total Float
  created_at String    @default("datetime('now')")
  pos_sales  pos_sales @relation(fields: [sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sale_id], map: "idx_pos_sale_items_sale")
  @@index([product_id], map: "idx_pos_sale_items_product")
}

// Receipt sequence scope: store + register session + business date.
model receipt_sequences {
  id                  Int    @id @default(autoincrement())
  store_id            String
  register_session_id Int
  business_date       String
  sequence            Int    @default(0)
  created_at          String @default("datetime('now')")
  updated_at          String @default("datetime('now')")

  @@unique([store_id, register_session_id, business_date], map: "uniq_receipt_sequence_scope")
  @@index([business_date], map: "idx_receipt_sequences_date")
}

// Manager approval request foundation.
// type examples: "void" | "refund" | "return" | "discount_override"
// status values: "pending" | "approved" | "rejected" | "cancelled"
model manager_approvals {
  id              Int               @id @default(autoincrement())
  approval_type   String
  requested_by    String
  approved_by     String?
  reason          String
  status          String            @default("pending")
  created_at      String            @default("datetime('now')")
  resolved_at     String?
  pos_corrections pos_corrections[]

  @@index([approval_type, status], map: "idx_manager_approvals_type_status")
  @@index([created_at], map: "idx_manager_approvals_created")
}

// Immutable correction document foundation.
// type values: "void" | "refund" | "return"
model pos_corrections {
  id                  Int                @id @default(autoincrement())
  correction_number   String             @unique
  type                String
  reason              String
  operator_id         String
  manager_approval_id Int?
  original_order_id   Int
  sale_id             Int?
  amount              Float              @default(0)
  metadata            String?
  created_at          String             @default("datetime('now')")
  manager_approvals   manager_approvals? @relation(fields: [manager_approval_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pos_sales           pos_sales?         @relation(fields: [sale_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([original_order_id], map: "idx_pos_corrections_order")
  @@index([sale_id], map: "idx_pos_corrections_sale")
  @@index([type, created_at], map: "idx_pos_corrections_type_created")
}

model read_model_snapshots {
  name       String @id
  data       String
  updated_at String
}

// ── Report snapshots (projection cache) ──────────────────────────────────────
model report_snapshots {
  projection String @id
  payload    String
  built_at   String @default("datetime('now')")
}

// ── Stock change log (append-only ledger) ─────────────────────────────────────
// Phase 3 additive columns (2026-05-15):
//   store_id    — store scope; defaults to "default-store" for existing rows
//   operator_id — user/cashier who triggered the change; nullable for legacy rows
//   source_ref  — free-form reference (clientSaleId, adjustment reason, etc.)
// Phase 6J additive columns (2026-05-15):
//   location_id — inventory location; nullable for legacy rows (global stock)
// Existing columns are unchanged for backward compatibility with POS sale path.
model stock_change_logs {
  id                  Int                  @id @default(autoincrement())
  menu_id             Int
  admin_id            Int?
  order_id            Int?
  change_type         String
  qty_before          Int
  qty_change          Int
  qty_after           Int
  note                String?
  store_id            String               @default("default-store")
  operator_id         String?
  source_ref          String?
  location_id         Int?
  created_at          String               @default("datetime('now')")
  menu                menu                 @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_locations inventory_locations? @relation(fields: [location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_scl_created")
  @@index([menu_id, created_at], map: "idx_scl_menu_created")
  @@index([store_id, created_at], map: "idx_scl_store_created")
  @@index([change_type], map: "idx_scl_change_type")
  @@index([location_id], map: "idx_scl_location")
}

// ── Inventory locations ───────────────────────────────────────────────────────
// Represents a physical or logical stock location within a store.
// type values: "warehouse" | "floor" | "pos" | "transit" | "damaged" | "virtual"
//   (canonical values in InventoryLocationType enum)
// Every store has one default location (is_default = true).
// The service layer creates the default location on first use.
model inventory_locations {
  id                       Int                        @id @default(autoincrement())
  store_id                 String                     @default("default-store")
  name                     String
  type                     String                     @default("warehouse")
  is_default               Boolean                    @default(false)
  is_active                Boolean                    @default(true)
  created_at               String                     @default("datetime('now')")
  inventory_stock_balances inventory_stock_balances[]
  stock_change_logs        stock_change_logs[]

  @@index([store_id], map: "idx_inv_loc_store")
  @@index([store_id, is_default], map: "idx_inv_loc_store_default")
  @@index([store_id, is_active], map: "idx_inv_loc_active")
}

// ── Inventory stock balances ──────────────────────────────────────────────────
// Per-location stock balance for each product.
// qty_on_hand  — physical units available at this location
// qty_reserved — units reserved for pending orders (optional, defaults 0)
//
// Uniqueness: one row per (menu_id, location_id) pair.
// Fallback: if no row exists for a product+location, callers fall back to
//           menu.stock (legacy global stock).
model inventory_stock_balances {
  id                  Int                 @id @default(autoincrement())
  menu_id             Int
  location_id         Int
  qty_on_hand         Int                 @default(0)
  qty_reserved        Int                 @default(0)
  updated_at          String              @default("datetime('now')")
  menu                menu                @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventory_locations inventory_locations @relation(fields: [location_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([menu_id, location_id], map: "uniq_stock_balance_product_location")
  @@index([location_id], map: "idx_stock_balance_location")
  @@index([menu_id], map: "idx_stock_balance_menu")
}

// ── Store settings (key-value config per store) ───────────────────────────────
// NOTE: No store_id column — keys are namespaced as "{storeId}:{key}" by
// StoresService to support multiple stores. Add a store_id column and index
// when this table is migrated to PostgreSQL.
model store_settings {
  key        String @id
  value      String @default("")
  updated_at String @default("datetime('now')")
}

// ── Sync outbox (transactional event publishing) ──────────────────────────────
// status values: "pending" | "processing" | "processed" | "failed" | "dead"
// Business vertical catalog for capability-based navigation.
model business_verticals {
  key         String  @id
  name        String
  description String?
  is_active   Boolean @default(true)
  created_at  String  @default("datetime('now')")
  updated_at  String  @default("datetime('now')")
}

// Platform module catalog. Module keys are referenced by frontend navigation
// and backend @RequireModule guards.
model platform_modules {
  key         String  @id
  name        String
  group       String
  description String?
  is_core     Boolean @default(false)
  is_active   Boolean @default(true)
  created_at  String  @default("datetime('now')")
  updated_at  String  @default("datetime('now')")

  @@index([group, is_active], map: "idx_platform_modules_group")
  @@index([is_core, is_active], map: "idx_platform_modules_core")
}

// Default module mapping per business vertical.
model business_vertical_modules {
  id           Int     @id @default(autoincrement())
  vertical_key String
  module_key   String
  is_default   Boolean @default(true)

  @@unique([vertical_key, module_key], map: "uniq_vertical_module")
  @@index([vertical_key], map: "idx_bvm_vertical")
  @@index([module_key], map: "idx_bvm_module")
}

// The store itself — previously synthetic (see the removed note in
// stores.service.ts#getStoreInfo); every other table's store_id column
// stays a loose string with no FK for now, this just gives that string a
// real row to anchor tier/billing state to.
//
// `tier` is the subscription plan (starter/business/enterprise, matching
// the pricing page) — unrelated to `customers.tier`, which is a per-customer
// loyalty tier. Not a Prisma enum: every other status-like column in this
// schema (role, verification_status, ...) is a plain String validated at
// the app layer (see StoreTier in libs/contracts), so this follows suit.
model stores {
  id         String  @id
  name       String
  tier       String  @default("starter")
  created_at String  @default("datetime('now')")
  updated_at String  @default("datetime('now')")

  @@index([tier], map: "idx_stores_tier")
}

// AI chat quota tracking — one row per (store, quota type, period). "period"
// is a plain string so the same table serves both granularities: 'YYYY-MM-DD'
// for the daily cap, 'YYYY-MM' for the monthly cap. A chat is counted once it
// passes the quota check (see AiUsageService), never before — a rejected
// request must not consume quota.
//
// Only wired up for the Owner Assistant endpoint (POST /api/llm/chat) today.
// The WhatsApp Customer Service bot can't be metered per-store yet because
// bot-dispatch.service.ts doesn't know which store a conversation belongs to
// (see the SEC-11 comment in checkout.service.ts) — enforcing this here
// would just meter one hardcoded default store regardless of who's texting.
model ai_usage_counters {
  id         Int    @id @default(autoincrement())
  store_id   String
  quota_type String
  period     String
  count      Int    @default(0)
  updated_at String @default("datetime('now')")

  @@unique([store_id, quota_type, period], map: "uniq_ai_usage_counter")
  @@index([store_id, quota_type], map: "idx_ai_usage_store_type")
}

// Store-level business profile. verified_business_vertical is the source of
// truth for module capability resolution.
model store_business_profiles {
  store_id                    String  @id
  requested_business_vertical String?
  verified_business_vertical  String  @default("general")
  verification_status         String  @default("unverified")
  verified_by                 String?
  verified_at                 String?
  notes                       String?
  created_at                  String  @default("datetime('now')")
  updated_at                  String  @default("datetime('now')")
}

// Per-store module exceptions for special cases.
model store_module_overrides {
  id         Int     @id @default(autoincrement())
  store_id   String
  module_key String
  enabled    Boolean
  reason     String?
  updated_by String?
  updated_at String  @default("datetime('now')")

  @@unique([store_id, module_key], map: "uniq_store_module_override")
  @@index([store_id], map: "idx_store_module_overrides_store")
  @@index([module_key], map: "idx_store_module_overrides_module")
}

model sync_outbox {
  id              Int     @id @default(autoincrement())
  event_type      String
  payload         String
  status          String  @default("pending")
  attempts        Int     @default(0)
  processed_at    String?
  created_at      String  @default("datetime('now')")
  next_attempt_at String?
  last_error      String?
}

// ── Sync inbox (event delivery tracking) ─────────────────────────────────────
model sync_inbox {
  id               Int     @id @default(autoincrement())
  event_type       String
  payload          String
  source_outbox_id Int?
  status           String  @default("pending")
  processed_at     String?
  created_at       String  @default("datetime('now')")

  @@index([created_at], map: "idx_inbox_created")
  @@index([status], map: "idx_inbox_status")
}

// ── Users ─────────────────────────────────────────────────────────────────────
// Phase 9: Added role and store_id columns.
// role defaults to 'cashier' for new accounts (least-privilege default).
// Existing rows get 'owner' via migration backfill.
// store_id defaults to 'default-store' for single-store deployments.
model users {
  id            Int             @id @default(autoincrement())
  email         String          @unique(map: "sqlite_autoindex_users_1")
  password_hash String
  role          String          @default("cashier")
  store_id      String          @default("default-store")
  created_at    String          @default("datetime('now')")
  updated_at    String?
  favorites     favorites[]
  notifications notifications[]
  order_ratings order_ratings[]
  orders        orders[]

  @@index([role], map: "idx_users_role")
  @@index([store_id], map: "idx_users_store")
}

// ── Webhook deduplication ─────────────────────────────────────────────────────
model webhook_dedupes {
  dedupe_key String @id
  created_at String @default("datetime('now')")
}

// ── Operation document sequence ───────────────────────────────────────────────
// Collision-safe per-store/type/date sequence for document numbers.
// Format: {TYPE_PREFIX}-{YYYYMMDD}-{STORE_SHORT}-{SEQ:04d}
// e.g. GR-20260515-DEF-0001
model operation_document_sequences {
  id            Int    @id @default(autoincrement())
  store_id      String
  document_type String
  business_date String
  sequence      Int    @default(0)
  created_at    String @default("datetime('now')")
  updated_at    String @default("datetime('now')")

  @@unique([store_id, document_type, business_date], map: "uniq_op_doc_seq_scope")
  @@index([business_date], map: "idx_op_doc_seq_date")
}

// ── Operation documents ───────────────────────────────────────────────────────
// Enterprise document foundation for stock and purchasing workflows.
//
// document_type values: "purchase_order" | "goods_receipt" | "stock_transfer" | "stock_adjustment"
// status values:        "draft" | "submitted" | "posted" | "cancelled"
//
// Posting rules:
//   purchase_order  → no stock movement (intent only)
//   goods_receipt   → RESTOCK movement per line at destination_location_id
//   stock_transfer  → TRANSFER_OUT at source_location_id + TRANSFER_IN at destination_location_id
//   stock_adjustment → ADJUSTMENT movement per line at destination_location_id
//
// source_location_id      – required for stock_transfer (origin)
// destination_location_id – required for goods_receipt, stock_transfer, stock_adjustment
// supplier_id / supplier_name – informational for purchase_order and goods_receipt
// linked_document_id      – links goods_receipt back to its purchase_order
model operation_documents {
  id                      Int                        @id @default(autoincrement())
  document_number         String                     @unique
  document_type           String
  status                  String                     @default("draft")
  store_id                String                     @default("default-store")
  source_location_id      Int?
  destination_location_id Int?
  supplier_id             String?
  supplier_name           String?
  linked_document_id      Int?
  created_by              String
  submitted_by            String?
  posted_by               String?
  cancelled_by            String?
  notes                   String?
  created_at              String                     @default("datetime('now')")
  submitted_at            String?
  posted_at               String?
  cancelled_at            String?
  lines                   operation_document_lines[]

  @@index([store_id, document_type, status], map: "idx_op_doc_store_type_status")
  @@index([document_type, status], map: "idx_op_doc_type_status")
  @@index([created_at(sort: Desc)], map: "idx_op_doc_created")
  @@index([linked_document_id], map: "idx_op_doc_linked")
}

// ── Operation document lines ──────────────────────────────────────────────────
// One row per product per document.
// unit_cost is optional — used for goods_receipt to record purchase price.
// metadata is a JSON string for future extensibility (e.g. lot number, expiry).
model operation_document_lines {
  id          Int                 @id @default(autoincrement())
  document_id Int
  menu_id     Int
  qty         Int
  unit_cost   Float?
  metadata    String?
  created_at  String              @default("datetime('now')")
  document    operation_documents @relation(fields: [document_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu        menu                @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([document_id], map: "idx_op_doc_line_document")
  @@index([menu_id], map: "idx_op_doc_line_menu")
}

// Supplier master data for purchase workflows.
model suppliers {
  id             Int     @id @default(autoincrement())
  store_id       String  @default("default-store")
  name           String
  code           String?
  contact_person String?
  phone          String?
  email          String?
  address        String?
  tax_number     String?
  notes          String?
  is_active      Boolean @default(true)
  created_at     String  @default("datetime('now')")
  updated_at     String  @default("datetime('now')")

  @@unique([store_id, code], map: "uniq_supplier_store_code")
  @@index([store_id, is_active], map: "idx_suppliers_store_active")
  @@index([name], map: "idx_suppliers_name")
}

// ── Phase 6D: F&B Vertical — Dining Areas ────────────────────────────────────
// A dining area groups tables (e.g. "Indoor", "Outdoor", "VIP Room").
// Phase 6D — 2026-05-15
model dining_areas {
  id          Int             @id @default(autoincrement())
  store_id    String          @default("default-store")
  name        String
  description String?
  sort_order  Int             @default(0)
  is_active   Boolean         @default(true)
  created_at  String          @default("datetime('now')")
  updated_at  String          @default("datetime('now')")
  tables      dining_tables[]

  @@index([store_id, is_active], map: "idx_dining_areas_store")
}

// ── Phase 6D: F&B Vertical — Dining Tables ───────────────────────────────────
// A physical or logical table within a dining area.
// status: "available" | "occupied" | "reserved" | "cleaning"
// Phase 6D — 2026-05-15
model dining_tables {
  id              Int               @id @default(autoincrement())
  store_id        String            @default("default-store")
  area_id         Int?
  table_number    String
  capacity        Int               @default(4)
  status          String            @default("available")
  is_active       Boolean           @default(true)
  created_at      String            @default("datetime('now')")
  updated_at      String            @default("datetime('now')")
  area            dining_areas?     @relation(fields: [area_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orders          orders[]
  kitchen_tickets kitchen_tickets[]

  @@unique([store_id, table_number], map: "uniq_table_number_store")
  @@index([store_id, status], map: "idx_dining_tables_store_status")
  @@index([area_id], map: "idx_dining_tables_area")
}

// ── Phase 6D: F&B Vertical — Kitchen Tickets ─────────────────────────────────
// A kitchen ticket is created when an order is confirmed.
// status: "pending" | "preparing" | "ready" | "served" | "cancelled"
// priority: "normal" | "rush" | "vip"
// Phase 6D — 2026-05-15
model kitchen_tickets {
  id            Int                    @id @default(autoincrement())
  store_id      String                 @default("default-store")
  order_id      Int
  table_id      Int?
  ticket_number String
  status        String                 @default("pending")
  priority      String                 @default("normal")
  notes         String?
  created_at    String                 @default("datetime('now')")
  updated_at    String                 @default("datetime('now')")
  ready_at      String?
  served_at     String?
  order         orders                 @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  table         dining_tables?         @relation(fields: [table_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items         kitchen_ticket_items[]

  @@unique([store_id, ticket_number], map: "uniq_kitchen_ticket_number")
  @@index([store_id, status], map: "idx_kitchen_tickets_store_status")
  @@index([order_id], map: "idx_kitchen_tickets_order")
}

// ── Phase 6D: F&B Vertical — Kitchen Ticket Items ────────────────────────────
// One row per order item on a kitchen ticket.
// status: "pending" | "preparing" | "ready" | "cancelled"
// Phase 6D — 2026-05-15
model kitchen_ticket_items {
  id         Int             @id @default(autoincrement())
  ticket_id  Int
  menu_id    Int
  name       String
  qty        Int             @default(1)
  notes      String?
  status     String          @default("pending")
  created_at String          @default("datetime('now')")
  updated_at String          @default("datetime('now')")
  ticket     kitchen_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id], map: "idx_kti_ticket")
  @@index([menu_id], map: "idx_kti_menu")
}

// ── Phase 7: Customers ────────────────────────────────────────────────────────
// A customer profile linked to sales and loyalty.
// phone is the primary lookup key (WhatsApp / POS search).
// tier: "regular" | "silver" | "gold" | "platinum"
// Phase 7 — 2026-05-15
model customers {
  id              Int               @id @default(autoincrement())
  store_id        String            @default("default-store")
  name            String
  phone           String?
  email           String?
  address         String?
  tier            String            @default("regular")
  notes           String?
  is_active       Boolean           @default(true)
  created_at      String            @default("datetime('now')")
  updated_at      String            @default("datetime('now')")
  orders          orders[]
  customer_points customer_points[]
  vouchers        vouchers[]
  pos_sales       pos_sales[]

  @@index([store_id, is_active], map: "idx_customers_store_active")
  @@index([name], map: "idx_customers_name")
  @@index([phone], map: "idx_customers_phone")
}

// ── Phase 7: Loyalty Programs ─────────────────────────────────────────────────
// Defines how points are earned and redeemed.
// earn_rate: points earned per IDR spent (e.g. 0.01 = 1 point per Rp100)
// redeem_rate: IDR value per point (e.g. 1.0 = Rp1 per point)
// Phase 7 — 2026-05-15
model loyalty_programs {
  id                 Int     @id @default(autoincrement())
  store_id           String  @default("default-store")
  name               String
  description        String?
  earn_rate          Float   @default(0.01)
  redeem_rate        Float   @default(1.0)
  min_redeem_points  Int     @default(100)
  points_expiry_days Int?
  is_active          Boolean @default(true)
  created_at         String  @default("datetime('now')")
  updated_at         String  @default("datetime('now')")

  @@index([store_id, is_active], map: "idx_loyalty_programs_store_active")
}

// ── Phase 7: Customer Points Ledger ──────────────────────────────────────────
// Append-only ledger of point transactions per customer.
// entry_type: "earn" | "redeem" | "expire" | "adjust"
// Phase 7 — 2026-05-15
model customer_points {
  id             Int       @id @default(autoincrement())
  customer_id    Int
  store_id       String    @default("default-store")
  entry_type     String
  points         Int
  balance_after  Int       @default(0)
  reference_type String?
  reference_id   String?
  note           String?
  expires_at     String?
  created_at     String    @default("datetime('now')")
  customer       customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id, created_at], map: "idx_customer_points_customer")
  @@index([store_id, created_at], map: "idx_customer_points_store")
}

// ── Phase 7: Promotions ───────────────────────────────────────────────────────
// A promotion is a named discount campaign with a validity window.
// promo_type: "order_discount" | "item_discount" | "bundle" | "buy_x_get_y" | "happy_hour"
// discount_type: "percent" | "amount"
// status: "draft" | "active" | "paused" | "expired"
// Phase 7 — 2026-05-15
model promotions {
  id                  Int               @id @default(autoincrement())
  store_id            String            @default("default-store")
  name                String
  description         String?
  promo_type          String            @default("order_discount")
  discount_type       String            @default("percent")
  discount_value      Float             @default(0)
  min_order_amount    Float             @default(0)
  max_discount_amount Float?
  status              String            @default("draft")
  starts_at           String?
  ends_at             String?
  usage_limit         Int?
  usage_count         Int               @default(0)
  created_at          String            @default("datetime('now')")
  updated_at          String            @default("datetime('now')")
  rules               promotion_rules[]
  vouchers            vouchers[]
  pos_sales           pos_sales[]

  @@index([store_id, status], map: "idx_promotions_store_status")
  @@index([starts_at, ends_at], map: "idx_promotions_dates")
}

// ── Phase 7: Promotion Rules ──────────────────────────────────────────────────
// Optional per-item or per-category rules for a promotion.
// rule_type: "include_product" | "exclude_product" | "include_category" | "min_qty"
// Phase 7 — 2026-05-15
model promotion_rules {
  id           Int        @id @default(autoincrement())
  promotion_id Int
  rule_type    String
  rule_value   String
  created_at   String     @default("datetime('now')")
  promotion    promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([promotion_id], map: "idx_promo_rules_promotion")
}

// ── Phase 7: Vouchers ─────────────────────────────────────────────────────────
// A voucher is a single-use or limited-use code that applies a promotion.
// status: "active" | "used" | "expired" | "cancelled"
// Phase 7 — 2026-05-15
model vouchers {
  id                  Int         @id @default(autoincrement())
  store_id            String      @default("default-store")
  code                String
  promotion_id        Int?
  discount_type       String      @default("percent")
  discount_value      Float       @default(0)
  min_order_amount    Float       @default(0)
  max_discount_amount Float?
  status              String      @default("active")
  usage_limit         Int         @default(1)
  usage_count         Int         @default(0)
  customer_id         Int?
  expires_at          String?
  created_at          String      @default("datetime('now')")
  updated_at          String      @default("datetime('now')")
  promotion           promotions? @relation(fields: [promotion_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer            customers?  @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([code, store_id], map: "uniq_voucher_code_store")
  @@index([store_id, status], map: "idx_vouchers_store_status")
  @@index([customer_id], map: "idx_vouchers_customer")
}

// ── Invoices (Sales Invoice / Faktur Penjualan) ───────────────────────────────
// Formal billing document for B2B customers or credit-term transactions.
// status: "draft" | "issued" | "paid" | "overdue" | "cancelled"
// payment_terms: "cod" | "net_7" | "net_14" | "net_30" | "net_60"
model invoices {
  id               Int             @id @default(autoincrement())
  invoice_number   String          @unique
  store_id         String          @default("default-store")
  order_id         Int?
  customer_name    String
  customer_phone   String?
  customer_email   String?
  customer_address String?
  status           String          @default("draft")
  payment_terms    String          @default("cod")
  issue_date       String
  due_date         String?
  paid_date        String?
  subtotal         Float           @default(0)
  discount         Float           @default(0)
  tax              Float           @default(0)
  total            Float           @default(0)
  notes            String?
  created_by       String?
  created_at       String          @default("datetime('now')")
  updated_at       String          @default("datetime('now')")
  lines            invoice_lines[]

  @@index([store_id, status], map: "idx_invoices_store_status")
  @@index([created_at(sort: Desc)], map: "idx_invoices_created")
  @@index([order_id], map: "idx_invoices_order")
}

// ── Invoice line items ────────────────────────────────────────────────────────
model invoice_lines {
  id          Int      @id @default(autoincrement())
  invoice_id  Int
  description String
  qty         Int      @default(1)
  unit_price  Float    @default(0)
  total       Float    @default(0)
  invoice     invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_lines_invoice")
}

// ── Invoice number sequences ──────────────────────────────────────────────────
model invoice_sequences {
  id            Int    @id @default(autoincrement())
  store_id      String
  business_date String
  sequence      Int    @default(0)
  created_at    String @default("datetime('now')")
  updated_at    String @default("datetime('now')")

  @@unique([store_id, business_date], map: "uniq_invoice_seq_scope")
  @@index([business_date], map: "idx_invoice_seq_date")
}

// ── Phase 12: Modifiers (FnB) ─────────────────────────────────────────────────
//
// Modifier model — for menu add-ons like topping, spice level, side dish, drink size.
// Each store can define groups of modifiers (e.g. "Topping", "Level Pedas").
// Each group has a list of options with optional price addition.
// Products can be linked to one or many groups via product_modifier_links.
//
// Conventions:
//   - selection_type: "single" | "multiple"
//     • single   = customer picks at most one option (radio).
//     • multiple = customer picks zero or more options (checkbox).
//   - is_required: when true, customer MUST pick at least one (single)
//     or at least the configured min_select count (multiple).
//   - price_delta in modifier_options is in rupiah, can be 0 or negative
//     (e.g. "Tanpa nasi" → -2000).

model modifier_groups {
  id             Int                      @id @default(autoincrement())
  store_id       String                   @default("default-store")
  name           String
  description    String?
  selection_type String                   @default("single")
  is_required    Boolean                  @default(false)
  min_select     Int                      @default(0)
  max_select     Int?
  sort_order     Int                      @default(0)
  is_active      Boolean                  @default(true)
  created_at     String                   @default("datetime('now')")
  updated_at     String                   @default("datetime('now')")
  options        modifier_options[]
  product_links  product_modifier_links[]

  @@index([store_id, is_active], map: "idx_modifier_groups_store_active")
}

model modifier_options {
  id          Int             @id @default(autoincrement())
  group_id    Int
  name        String
  price_delta Float           @default(0)
  sort_order  Int             @default(0)
  is_active   Boolean         @default(true)
  created_at  String          @default("datetime('now')")
  group       modifier_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([group_id], map: "idx_modifier_options_group")
}

model product_modifier_links {
  id         Int             @id @default(autoincrement())
  menu_id    Int
  group_id   Int
  sort_order Int             @default(0)
  created_at String          @default("datetime('now')")
  group      modifier_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu       menu            @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([menu_id, group_id], map: "uniq_product_modifier_link")
  @@index([menu_id], map: "idx_product_modifier_links_menu")
}

// ── Phase 12: Recipes / BOM (FnB) ─────────────────────────────────────────────
//
// Recipe links a finished menu item to its raw ingredients.
// One recipe per menu (unique). yield_qty represents how many servings
// the recipe produces in one preparation cycle (default 1).
//
// recipe_ingredients are individual ingredient lines:
//   - ingredient_menu_id refers to a menu row with product_type = "material"
//   - qty represents how much of that ingredient is consumed per serving
//   - unit_code is taken from the ingredient at the time of recipe creation
//     (snapshot — protects against silent drift if the ingredient unit changes).

model recipes {
  id          Int                  @id @default(autoincrement())
  menu_id     Int                  @unique
  yield_qty   Float                @default(1)
  yield_unit  String?
  notes       String?
  is_active   Boolean              @default(true)
  created_at  String               @default("datetime('now')")
  updated_at  String               @default("datetime('now')")
  menu        menu                 @relation("MenuRecipe", fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredients recipe_ingredients[]

  @@index([menu_id], map: "idx_recipes_menu")
}

model recipe_ingredients {
  id                 Int     @id @default(autoincrement())
  recipe_id          Int
  ingredient_menu_id Int
  qty                Float
  unit_code          String?
  notes              String?
  sort_order         Int     @default(0)
  created_at         String  @default("datetime('now')")
  recipe             recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient         menu    @relation("MenuAsIngredient", fields: [ingredient_menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipe_id], map: "idx_recipe_ingredients_recipe")
  @@index([ingredient_menu_id], map: "idx_recipe_ingredients_ingredient")
}

// ── Phase 12: Stock Opname (Retail) ───────────────────────────────────────────
//
// Stock opname (physical count) — compares system stock vs counted stock,
// posts the variance to inventory ledger as ADJUSTMENT movements.
//
// Lifecycle:
//   draft     → cashier/staff records counted_qty per product
//   submitted → posted by manager; variance lines posted as ADJUSTMENT
//   cancelled → discarded without posting
//
// system_qty snapshot is captured at session creation so concurrent sales
// don't pollute the variance figure.

model stock_opname_sessions {
  id                   Int                  @id @default(autoincrement())
  session_number       String               @unique
  store_id             String               @default("default-store")
  location_id          Int?
  status               String               @default("draft")
  notes                String?
  created_by           String
  submitted_at         String?
  posted_at            String?
  posted_by            String?
  cancelled_at         String?
  cancelled_by         String?
  cancelled_reason     String?
  total_variance_qty   Int                  @default(0)
  total_variance_value Float                @default(0)
  created_at           String               @default("datetime('now')")
  updated_at           String               @default("datetime('now')")
  lines                stock_opname_lines[]

  @@index([store_id, status], map: "idx_stock_opname_store_status")
  @@index([created_at], map: "idx_stock_opname_created")
}

model stock_opname_lines {
  id             Int                   @id @default(autoincrement())
  session_id     Int
  menu_id        Int
  product_name   String
  system_qty     Int
  counted_qty    Int?
  variance_qty   Int                   @default(0)
  unit_cost      Float?
  variance_value Float                 @default(0)
  notes          String?
  created_at     String                @default("datetime('now')")
  updated_at     String                @default("datetime('now')")
  session        stock_opname_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu           menu                  @relation(fields: [menu_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([session_id, menu_id], map: "uniq_stock_opname_session_menu")
  @@index([session_id], map: "idx_stock_opname_lines_session")
}
