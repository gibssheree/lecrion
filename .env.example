# ─────────────────────────────────────────────────────────────────────────────
# Lecrion — contoh konfigurasi environment
#
# Salin file ini menjadi `.env` di root repo, lalu isi nilainya:
#     cp .env.example .env
#
# `.env` TIDAK pernah di-commit (lihat .gitignore). Di server produksi, file
# ini dibaca oleh docker compose (`env_file`) untuk service api dan worker.
# ─────────────────────────────────────────────────────────────────────────────

# ── Wajib ────────────────────────────────────────────────────────────────────

# Lokasi database SQLite. Di dalam container, /app/database dipetakan ke volume
# `lecrion_db` supaya data tetap ada saat container di-recreate.
DATABASE_URL=file:/app/database/canteen.db

# Rahasia penandatanganan JWT. API MENOLAK start bila kosong (SEC-02) — tidak
# ada nilai default, supaya tidak ada environment yang berjalan dengan secret
# yang bisa ditebak. Buat nilai acak, masing-masing berbeda:
#     openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Origin yang diizinkan CORS + Socket.IO. Isi dengan URL publik Anda.
# Bisa lebih dari satu, dipisah koma. "*" mengizinkan semua origin —
# jangan dipakai di produksi.
DASHBOARD_ORIGIN=https://pos.contoh.com

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Harus "false" di produksi. Bila "true", seluruh pemeriksaan autentikasi
# dilewati — khusus debugging lokal.
AUTH_DISABLED=false

# ── Masa berlaku token ───────────────────────────────────────────────────────
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── API key antar-service ────────────────────────────────────────────────────
# Punya nilai default yang bisa ditebak di dalam kode — WAJIB diganti nilai
# acak di produksi.
BOT_API_KEY=
WORKER_API_KEY=
DASHBOARD_API_KEY=

# ── Identitas default tenant/store ───────────────────────────────────────────
DEFAULT_STORE_ID=default-store
DEFAULT_TENANT_ID=default
DEFAULT_ORDER_TYPE=pickup
DEFAULT_PAYMENT_METHOD=Cash

# ── WhatsApp (Fonnte) — opsional ─────────────────────────────────────────────
# Kosongkan bila belum memakai bot WhatsApp; API tetap jalan normal tanpa ini.
# Webhook Fonnte diarahkan ke:  https://domain-anda/api/bot/webhook
FONNTE_TOKEN=
FONNTE_WA_NUMBER=
FONNTE_WEBHOOK_SECRET=

# ── AI chatbot (Gemini) — opsional ───────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Perilaku bot di grup WhatsApp ────────────────────────────────────────────
GROUP_COMMAND_PREFIX=!
GROUP_REPLY_ONLY_WHEN_TAGGED=true
GROUP_ALLOW_PREFIX_COMMAND=true
GROUP_ALLOW_REPLY_FOLLOWUP=true
GROUP_TAG_ALIASES=
GROUP_TAG_KEYWORDS=

# ── Worker: interval & ambang batas ──────────────────────────────────────────
OUTBOX_POLL_MS=5000
READ_MODEL_INTERVAL_MS=60000
LOW_STOCK_ALERTS_ENABLED=false
LOW_STOCK_CHECK_INTERVAL_MS=3600000
LOW_STOCK_THRESHOLD=5
# Nomor WA tujuan alert stok menipis, dipisah koma. Kosong = alert dimatikan.
LOW_STOCK_ALERT_TARGETS=
REPORT_RECIPIENT=

# ── Ambang persetujuan kasir ─────────────────────────────────────────────────
MANAGER_PIN=
VOID_MAX_AGE_MINUTES=60
REFUND_APPROVAL_THRESHOLD_IDR=100000
DISCOUNT_APPROVAL_THRESHOLD_IDR=50000
