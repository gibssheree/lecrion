{
  "name": "worker",
  "version": "0.0.1",
  "description": "Background worker — outbox processor, read-model scheduler, low-stock notifier",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "nodemon --exec ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
