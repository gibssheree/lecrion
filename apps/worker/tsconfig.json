{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../..",
    "noEmit": false,
    // libs/db/src/projections has no .ts source — only committed .js/.d.ts
    // from before that module was moved out of the build. ts-node resolves it
    // fine, but tsc skips .js unless allowJs is on, and the compiled worker
    // then crashes on a missing module. declaration must be off because tsc
    // refuses to emit declarations for a JS input.
    "allowJs": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "../../libs/**/*.ts", "../../libs/**/*.js"],
  "exclude": ["node_modules", "dist", "../../libs/**/dist"]
}
