{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "./",
    "paths": {
      "@libs/db/*": ["../../libs/db/*"],
      "@libs/contracts/*": ["../../libs/contracts/*"],
      "@libs/common/*": ["../../libs/common/*"],
      "@libs/queue/*": ["../../libs/queue/*"],
      "@libs/realtime/*": ["../../libs/realtime/*"],
      "@bot/*": ["../bot/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../libs/**/*.ts", "../bot/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
