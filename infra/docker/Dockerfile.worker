# syntax=docker/dockerfile:1
# infra/docker/Dockerfile.worker
#
# Multi-stage build for the Worker (apps/worker).
# Phase 6 hardening: uses compiled TypeScript output.
#
# Build: docker build -f infra/docker/Dockerfile.worker -t lecrion-worker .

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json ./

RUN npm ci --ignore-scripts

COPY apps/worker ./apps/worker
COPY libs ./libs
COPY prisma ./prisma

# Compile worker TypeScript
RUN npx tsc -p apps/worker/tsconfig.json --outDir apps/worker/dist 2>/dev/null || \
    npx tsc --project tsconfig.json --outDir dist_worker 2>/dev/null || \
    echo "Using ts-node fallback"

# ── Stage 2: production ───────────────────────────────────────────────────────
FROM node:22-alpine AS app

WORKDIR /app

RUN addgroup -S lecrion && adduser -S lecrion -G lecrion

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /app/apps/worker ./apps/worker
COPY --from=builder /app/libs ./libs
COPY --from=builder /app/prisma ./prisma

RUN mkdir -p database && chown lecrion:lecrion database

HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
  CMD node -e "process.exit(0)" || exit 1

ENV NODE_ENV=production
ENV LOG_LEVEL=info

USER lecrion

# Run worker using ts-node (worker is lightweight, ts-node overhead is acceptable)
CMD ["node", "--require", "ts-node/register", "--require", "tsconfig-paths/register", "apps/worker/src/main.ts"]
