# syntax=docker/dockerfile:1
# infra/docker/Dockerfile.worker
#
# The worker (apps/worker) is a lightweight DB-polling process (outbox
# processor, read-model scheduler, low-stock notifier — no Redis/BullMQ).
# It runs via ts-node against its TypeScript source directly, same as in
# dev (`npm run start:worker`), so this image keeps devDependencies
# (ts-node, tsconfig-paths, typescript) — the ts-node overhead is
# acceptable for a single lightweight background process.
#
# Build: docker build -f infra/docker/Dockerfile.worker -t lecrion-worker .

FROM node:22-alpine AS app

WORKDIR /app

RUN addgroup -S lecrion && adduser -S lecrion -G lecrion

# Copy workspace manifests — apps/worker/package.json MUST be present before
# `npm ci` or its dependencies (ts-node, tsconfig-paths, typescript,
# better-sqlite3, @prisma/client) won't be resolved into the install.
COPY package.json package-lock.json ./
COPY apps/worker/package.json ./apps/worker/
COPY tsconfig.json ./
COPY prisma.config.ts ./

# No --ignore-scripts: better-sqlite3's install script builds/downloads its
# native binding — skipping it crashes at runtime with a "Could not locate
# the bindings file" error.
RUN npm ci

COPY apps/worker ./apps/worker
COPY libs ./libs
COPY prisma ./prisma

# Generate the Prisma client for this schema (no postinstall hook runs it).
RUN npx prisma generate

RUN mkdir -p database && chown lecrion:lecrion database

HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=2 \
  CMD node -e "process.exit(0)" || exit 1

ENV NODE_ENV=production
ENV LOG_LEVEL=info

USER lecrion

CMD ["node", "--require", "ts-node/register", "--require", "tsconfig-paths/register", "apps/worker/src/main.ts"]
