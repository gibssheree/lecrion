# syntax=docker/dockerfile:1
# infra/docker/Dockerfile.api
#
# Multi-stage build for the NestJS API (apps/api).
# Phase 6 hardening: uses compiled dist/, not ts-node.
#
# Build: docker build -f infra/docker/Dockerfile.api -t lecrion-api .
# Run:   docker run -p 3000:3000 --env-file .env lecrion-api

# ── Stage 1: install all deps (including dev for build) ──────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY tsconfig.json ./

# Install all deps (dev included for build)
RUN npm ci --ignore-scripts

# Copy source
COPY apps/api ./apps/api
COPY libs ./libs
COPY prisma ./prisma

# Build NestJS API
WORKDIR /app/apps/api
RUN npx nest build

# ── Stage 2: production image ─────────────────────────────────────────────────
FROM node:22-alpine AS app

WORKDIR /app

# Security: run as non-root
RUN addgroup -S lecrion && adduser -S lecrion -G lecrion

# Copy workspace manifests for prod install
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/

# Install production deps only
RUN npm ci --omit=dev --ignore-scripts

# Copy compiled output
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy prisma schema + migrations (needed for prisma client)
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/libs ./libs

# DB directory
RUN mkdir -p database && chown lecrion:lecrion database

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

ENV NODE_ENV=production
ENV LOG_LEVEL=info

USER lecrion

EXPOSE 3000

# Run Prisma migrate deploy then start compiled API
CMD ["sh", "-c", "npx prisma migrate deploy && node apps/api/dist/apps/api/src/main.js"]
