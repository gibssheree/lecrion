# syntax=docker/dockerfile:1
# infra/docker/Dockerfile.web
#
# Multi-stage build for the pos-web frontend (apps/pos-web).
# Builds the Vite SPA, then serves the static output + reverse-proxies
# /api and /ws/realtime to the NestJS api service via nginx.
#
# Build: docker build -f infra/docker/Dockerfile.web -t lecrion-web .

# ── Stage 1: build the SPA ────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/pos-web/package.json ./apps/pos-web/
COPY tsconfig.json ./

RUN npm ci --ignore-scripts

COPY apps/pos-web ./apps/pos-web

WORKDIR /app/apps/pos-web
RUN npx vite build

# ── Stage 2: serve with nginx ──────────────────────────────────────────────────
FROM nginx:1.27-alpine AS app

COPY infra/nginx/lecrion.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/pos-web/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1

EXPOSE 80
